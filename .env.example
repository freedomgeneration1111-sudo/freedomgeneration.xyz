# Public-site build variables (server/build process only; never use NEXT_PUBLIC_)
SANITY_PROJECT_ID=
SANITY_DATASET=production
# Required only when the dataset is private. Create a read-only Viewer token.
SANITY_API_READ_TOKEN=

# Optional rollback override. Omit for the normal Sanity-first configuration.
# SANITY_JOURNAL_SOURCE=fixture

# Sanity Studio variables (copy this file to studio/.env and use these names there)
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
