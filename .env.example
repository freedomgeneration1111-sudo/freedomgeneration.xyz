# Public-site build overrides (server/build process only; never use NEXT_PUBLIC_)
# These repeat the built-in public defaults and may be changed for a deliberate override.
SANITY_PROJECT_ID=ypv2g0fi
SANITY_DATASET=production
SANITY_JOURNAL_SOURCE=sanity
# Optional and not required for the public production dataset. For private datasets only,
# create a least-privilege read-only Viewer token.
SANITY_API_READ_TOKEN=

# Explicit rollback/development override. Fixture mode is never selected just because
# the public-site variables above are absent. Change SANITY_JOURNAL_SOURCE above to fixture.

# Sanity Studio variables (copy this file to studio/.env and use these names there)
SANITY_STUDIO_PROJECT_ID=ypv2g0fi
SANITY_STUDIO_DATASET=production
